# Which platform to run: "discord" or "slack"
SAVAGEBOT_PLATFORM=discord

# Password used by the bot's admin commands (e.g. !shutdown)
SAVAGEBOT_PASSWORD=changeme

# --- Discord (required when SAVAGEBOT_PLATFORM=discord) ---
DISCORD_TOKEN=

# --- Slack (required when SAVAGEBOT_PLATFORM=slack) ---
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# App-Level Token with connections:write scope (xapp-...)
SLACK_APP_TOKEN=

# --- Logging (optional) ---
# LOG_LEVEL=INFO

# --- Redis (optional, set by docker-compose when using the redis service) ---
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
